pipeline {
    agent any
    environment {
         DOCKER_IMAGE  = credentials('docker-image')
         AWS_REGION    = credentials('aws-region')       
         EKS_CLUSTER   = credentials('cluster-name')   
         KUBECONFIG    = credentials('kube-config')
    }
    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'main', url: 'https://github.com/amalinbics/Trend.git'
            }
        }
        stage('Build Docker Image') {
            steps {
                script {
                    sh "docker build -t ${DOCKER_IMAGE}:${env.BUILD_NUMBER} ."
                }
            }
        }
        stage('Push Docker Image') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USERNAME')]) {
                        sh "docker login -u ${DOCKER_USERNAME} -p ${DOCKER_PASSWORD}"
                        sh "docker push ${DOCKER_IMAGE}:${env.BUILD_NUMBER}"
                    }
                }
            }
        }
        stage('Replace the image') {
            steps {
                script {
                    // Create a temporary deployment file with the new color label
                    sh """
                    sed -i \
                        -e "s|REPO_URI_PLACEHOLDER|${DOCKER_IMAGE}|g" \
                        -e "s|TAG_PLACEHOLDER|${env.BUILD_NUMBER}|g" eks/deployment.yaml
                    """
                }
            }
        }
        stage('Setup kubeconfig') {
            steps {
                sh '''
                    mkdir -p $(dirname $KUBECONFIG)
                    aws eks update-kubeconfig --region $AWS_REGION --name $EKS_CLUSTER --kubeconfig $KUBECONFIG
                '''
            }
        }
        stage('Deploy to EKS') {
            steps {
                sh '''
                    kubectl --kubeconfig $KUBECONFIG apply -f eks/secret.yaml  
                    kubectl --kubeconfig $KUBECONFIG apply -f eks/deployment.yaml 
                    kubectl --kubeconfig $KUBECONFIG apply -f eks/service.yaml 
                '''
            }
        }
    }
}